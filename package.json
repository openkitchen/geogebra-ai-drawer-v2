{
  "name": "geogebra-ai-drawer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev:client": "vite",
    "dev:server": "node server/index.mjs",
    "dev": "concurrently -n client,server -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:v2:web": "npm --prefix apps/web run dev",
    "dev:v2:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 3002",
    "dev:v2": "concurrently -n web,api -c \"cyan,magenta\" \"npm run dev:v2:web\" \"npm run dev:v2:api\"",
    "acceptance:v2:web": "node scripts/v2_acceptance_web_playwright.mjs",
    "acceptance:v2:web:dialogue": "node scripts/v2_acceptance_web_dialogue_playwright.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/openai-compatible": "^2.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ai": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "zod": "^3.25.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.55.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}

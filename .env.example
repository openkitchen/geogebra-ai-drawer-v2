API_PROXY_PORT=3002

# Put real keys as separate env vars (do not commit real keys):
KIMI_API_KEY=YOUR_KIMI_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY

# Model endpoints (JSON). Keys can be referenced via ${ENV_VAR}.
# Each endpoint can define multiple model variants under `models` so you don't duplicate baseURL/apiKey.
# Convention:
# - `models.main` is used for the main chat/drawing flow.
# - `models.intent` is used for /api/intent (cheap/fast intent routing).
# - `models.fallback` is used when the main model times out (Kimi only).
LLM_ENDPOINTS_JSON='[
  {
    "id": "kimi",
    "label": "Kimi",
    "provider": "openai-compatible",
    "baseURL": "https://api.moonshot.cn/v1",
    "apiKey": "${KIMI_API_KEY}",
    "models": {
      "main": "kimi-k2-thinking",
      "intent": "moonshot-v1-8k",
      "fallback": "moonshot-v1-8k"
    }
  },
  {
    "id": "gemini",
    "label": "Gemini",
    "provider": "google",
    "apiKey": "${GEMINI_API_KEY}",
    "models": {
      "main": "gemini-2.5-flash",
      "intent": "gemini-2.5-flash"
    }
  }
]'

# Note: some gateways may be "CLI-only" (they validate the official client).
# For those, you can use `provider: "codex-cli"` to call via the official Codex CLI process
# (local dev only; requires `codex` installed and logged-in on the server machine).

# Optional: small/cheap intent classifier (used by /api/intent).
# It references an endpoint id from LLM_ENDPOINTS_JSON.
INTENT_ENDPOINT_ID=kimi
INTENT_TIMEOUT_MS=2500

# Optional: main LLM timeout (ms)
# Slow models / busy gateways may need a longer timeout (e.g. 40000).
LLM_TIMEOUT_MS=40000

# Optional: for openai-compatible gateways that frequently fail JSON parsing,
# prefer tool-calling as the first structured output strategy (then fall back to JSON parsing).
LLM_COMPAT_PREFER_TOOL_CALLING=true

# Optional: log per-attempt LLM connection info (no secrets): endpoint/provider/baseURL/model/latency/errors.
LLM_LOG_CONNECTION_INFO=false

# Optional: when a model is explicitly selected in UI, default fallback is "preferred -> kimi".
# Set true to keep trying all configured endpoints after Kimi.
LLM_ALLOW_ALL_FALLBACK=false

# Optional: DO NOT use a small/cheap model (like moonshot-v1-8k) as the primary chat responder.
# If you explicitly want to allow a fast fallback model inside Kimi for chat, set this true.
KIMI_ALLOW_CHAT_FALLBACK_MODEL=false

# Optional: Auto mode routing preference (when UI selects "auto").
# Backward compatible default is kimi-first; you can override it.
LLM_AUTO_PREFERRED_ENDPOINT_ID=kimi
# Optional: explicit ordered list for Auto mode. Disabled/unknown ids are ignored.
# Example: LLM_AUTO_ORDER=packy-minimax,packy-glm47,kimi,gemini
LLM_AUTO_ORDER=

# Optional: when UI explicitly selects an endpoint, configure fallback chain ids (after the selected one).
# Default is kimi-only. Example: LLM_EXPLICIT_FALLBACK_ORDER=kimi,gemini
LLM_EXPLICIT_FALLBACK_ORDER=

# Optional: reduce provider capability warning noise from AI SDK.
# Set false to turn off warnings like "responseFormat is not supported".
AI_SDK_LOG_WARNINGS=true

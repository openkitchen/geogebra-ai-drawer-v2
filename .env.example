LLM_ROLE_BINDINGS_JSON='{
  "main": "ve-gpt-5.2-chat",
  "repair": "ve-gemini-3-pro-preview",
  "fast": "ve-o4-mini",
  "fallback": "ve-gpt-4.1-mini",
  "gemini_fast": "ve-gemini-flash"
}'

# v2 backend default role
V2_LLM_ROLE=main
# Optional: comma-separated roles to try when the primary model fails (rate limit / temporary outage).
V2_LLM_FALLBACK_ROLES=fast,fallback
V2_LLM_TIMEOUT_S=20
V2_LLM_TEMPERATURE=0

API_PROXY_PORT=3002

# Put real keys as separate env vars (do not commit real keys):
VECTORENGINE_API_KEY=YOUR_VECTOR_ENGINE_KEY

# v1-style model routing (recommended): aliases + roles
# provider: openai | openai-compatible | google
# Note: in v2 we currently prefer OpenAI-compatible calls even for Gemini (via VectorEngine baseURL).


{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "explanation": { "type": "string" },
    "commands": {
      "type": "array",
      "items": { "type": "string" }
    },
    "overlayText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corner": {
          "type": "string",
          "enum": ["top-left", "top-right", "bottom-left", "bottom-right"]
        },
        "text": { "type": "string" }
      }
    }
  },
  "required": ["explanation", "commands"]
}
